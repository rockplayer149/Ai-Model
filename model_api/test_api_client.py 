import requests
import json

# API Configuration
API_URL = "http://localhost:5001"

def test_email(email_text, description=""):
    """Test a single email"""
    print("\n" + "="*70)
    if description:
        print(f"Testing: {description}")
    print("="*70)
    
    try:
        response = requests.post(
            f"{API_URL}/predict",
            json={"text": email_text},
            headers={"Content-Type": "application/json"},
            timeout=10
        )
        
        if response.status_code == 200:
            result = response.json()
            
            # Display results
            verdict = result.get('verdict', 'unknown').upper()
            confidence = result.get('confidence', 0) * 100
            classification = result.get('classification', 'Unknown')
            
            # Color code based on verdict
            if verdict == 'HAM':
                icon = "✅"
                color = "SAFE"
            elif verdict == 'SPAM':
                icon = "⚠️"
                color = "SPAM"
            elif verdict == 'PHISHING':
                icon = "🚨"
                color = "DANGER"
            else:
                icon = "❓"
                color = "UNKNOWN"
            
            print(f"\n{icon} Result: {color}")
            print(f"   Classification: {classification}")
            print(f"   Confidence: {confidence:.1f}%")
            
            # Show probabilities
            probs = result.get('probabilities', {})
            print(f"\n   Probabilities:")
            print(f"      Legitimate: {probs.get('legitimate', 0)*100:.1f}%")
            print(f"      Spam:       {probs.get('spam', 0)*100:.1f}%")
            print(f"      Phishing:   {probs.get('phishing', 0)*100:.1f}%")
            
            # Show explanation
            explanation = result.get('explanation', [])
            if explanation:
                print(f"\n   Reasons:")
                for reason in explanation:
                    print(f"      • {reason}")
            
            return result
        else:
            print(f"❌ Error: {response.status_code}")
            print(f"   {response.text}")
            return None
            
    except requests.exceptions.ConnectionError:
        print("❌ Error: Could not connect to API server")
        print("   Make sure the server is running: python app.py")
        return None
    except requests.exceptions.Timeout:
        print("❌ Error: Request timed out")
        return None
    except Exception as e:
        print(f"❌ Error: {e}")
        return None

def check_server_health():
    """Check if server is healthy"""
    print("\n" + "="*70)
    print("Checking Server Health")
    print("="*70)
    
    try:
        response = requests.get(f"{API_URL}/health", timeout=5)
        if response.status_code == 200:
            result = response.json()
            print(f"\n✅ Server Status: {result.get('status', 'unknown')}")
            print(f"   Model Loaded: {result.get('model_loaded', False)}")
            print(f"   Working Dir: {result.get('working_directory', 'N/A')}")
            return True
        else:
            print(f"❌ Server returned error: {response.status_code}")
            return False
    except requests.exceptions.ConnectionError:
        print("❌ Cannot connect to server at", API_URL)
        print("   Start the server with: python app.py")
        return False
    except Exception as e:
        print(f"❌ Error: {e}")
        return False

def get_model_info():
    """Get model information"""
    try:
        response = requests.get(f"{API_URL}/info", timeout=5)
        if response.status_code == 200:
            info = response.json()
            print("\n" + "="*70)
            print("Model Information")
            print("="*70)
            print(f"\n   Name: {info.get('model_name', 'Unknown')}")
            print(f"   Version: {info.get('version', 'Unknown')}")
            
            classes = info.get('classes', {})
            if isinstance(classes, dict):
                print(f"   Classes:")
                for key, value in classes.items():
                    print(f"      {key}: {value}")
            
            print(f"   Features: {info.get('features', 0)}")
            print(f"   Description: {info.get('description', 'N/A')}")
            return True
    except:
        print("\n⚠️  Could not fetch model info")
        return False

